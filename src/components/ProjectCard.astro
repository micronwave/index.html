---
import type { Project } from '../data/content';
import ProjectFlow from './ProjectFlow.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const detailId = `project-detail-${project.name.replace(/\s+/g, '-').toLowerCase()}`;
const flow = project.flow ?? [];
---

<div class="project-item">
  <div class="project-top">
    <span class="project-name">{project.name}</span>
    <span class={`project-status ${project.status}`}>{project.status}</span>
  </div>
  <p class="project-tagline">{project.tagline}</p>
  <ul class="project-bullets">
    {project.bullets.slice(0, 3).map((b) => <li>{b}</li>)}
  </ul>

  <div class="project-action-row">
    <button
      class="project-detail-toggle"
      type="button"
      aria-expanded="false"
      aria-controls={detailId}
    >
      <svg
        class="project-detail-chevron"
        width="11"
        height="11"
        viewBox="0 0 11 11"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="1.5,3.5 5.5,7.5 9.5,3.5" />
      </svg>
      <span>details</span>
    </button>

    {(project.githubUrl || project.liveUrl) && (
      <div class="project-links">
        {project.githubUrl && (
          <a class="project-link" href={project.githubUrl} target="_blank" rel="noopener noreferrer">
            Source <span class="arrow">↗</span>
          </a>
        )}
        {project.liveUrl && (
          <a class="project-link" href={project.liveUrl} target="_blank" rel="noopener noreferrer">
            Live <span class="arrow">↗</span>
          </a>
        )}
      </div>
    )}
  </div>

  <div id={detailId} class="project-detail" aria-hidden="true">
    <div class="project-detail-inner">
      <div class="project-detail-content">

        {flow.length > 0 && <ProjectFlow steps={flow} />}

        {project.screenshotUrl && project.detail ? (
          <div class="project-preview-problem-row">
            <div class="project-preview-section">
              <span class="project-detail-label">preview</span>
              <div class="project-preview-frame">
                <img
                  src={project.screenshotUrl}
                  alt={`${project.name} interface`}
                  class="project-preview-img"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="project-detail-section">
              <span class="project-detail-label">The problem</span>
              <p class="project-detail-desc">{project.detail.problem}</p>
            </div>
          </div>
        ) : project.screenshotUrl ? (
          <div class="project-preview-section">
            <span class="project-detail-label">preview</span>
            <div class="project-preview-frame">
              <img
                src={project.screenshotUrl}
                alt={`${project.name} interface`}
                class="project-preview-img"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        ) : project.detail ? (
          <div class="project-detail-section">
            <span class="project-detail-label">The problem</span>
            <p class="project-detail-desc">{project.detail.problem}</p>
          </div>
        ) : null}

        {project.detail && (
          <div class="project-detail-section">
            <span class="project-detail-label">Decisions</span>
            <ul class="project-detail-decisions">
              {project.detail.decisions.map((d) => (
                <li>
                  <span class="decision-num" aria-hidden="true">/</span>
                  <span>{d}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

      </div>
    </div>
  </div>
</div>
