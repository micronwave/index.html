---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Aaron Altergott',
  description = 'Operations engineer building with cloud, security, and AI.',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://aaronaltergott.cv');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=5" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --bg-deep:      #0e0d0a;
    --bg-surface:   #1a1814;
    --accent:       #d4a855;
    --green:        #5c7a4d;
    --text:         #e0daca;
    --text-dim:     #908a7c;
    --text-faint:   #5a554a;
    --border:       #2a2620;
    --font-heading: 'Libre Baskerville', Georgia, serif;
    --font-body:    'DM Mono', 'Menlo', monospace;
    --font-mono:    'DM Mono', 'Menlo', monospace;
  }

  html {
    font-size: 16px;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    background: var(--bg-deep);
    color: var(--text);
    font-family: var(--font-body);
    line-height: 1.6;
    overflow-x: hidden;
  }

  ::selection {
    background: var(--accent);
    color: var(--bg-deep);
  }

  a {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  a:hover { color: var(--green); }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* ── Layout ── */
  .page-wrapper {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 80px);
  }

  /* ── Nav ── */
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 20px clamp(24px, 5vw, 80px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(14, 13, 10, 0.85);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }
  .site-nav.scrolled {
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: var(--border);
  }

  .nav-name {
    font-family: var(--font-heading);
    font-size: 14px;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
    font-weight: 400;
  }

  .nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
  }
  .nav-links a {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    text-transform: lowercase;
    transition: color 0.2s ease;
  }
  .nav-links a:hover { color: var(--green); }

  /* ── Hero ── */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 80px;
    gap: 24px;
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green);
  }

  .hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(52px, 9vw, 100px);
    line-height: 1.0;
    font-weight: 400;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .hero h1 em {
    display: inline-block;
    font-style: italic;
    color: var(--accent);
    line-height: 1.08;
    margin-left: -0.045em;
    padding-left: 0.045em;
  }

  .hero-sub {
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.65;
    color: var(--text-dim);
    max-width: 520px;
  }

  .hero-links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .hero-link {
    appearance: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 0;
    transition: color 0.2s ease;
  }
  .hero-link:hover {
    color: var(--green);
  }
  .hero-link:hover .hero-link-arrow {
    transform: translate(2px, -2px);
    color: var(--accent);
  }
  .hero-link-text {
    transition: none;
  }
  .hero-link-arrow {
    font-family: var(--font-mono);
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  .hero-email {
    display: inline-flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 10px;
    min-width: 0;
    white-space: nowrap;
  }

  .hero-email-address {
    color: var(--text-dim);
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateX(-6px);
    transition:
      max-width 0.32s ease,
      opacity 0.22s ease,
      transform 0.32s ease;
    white-space: nowrap;
  }

  .hero-email.visible .hero-email-address {
    max-width: 220px;
    opacity: 1;
    transform: translateX(0);
  }

  .hero-copy-btn {
    appearance: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 4px 3px;
    color: var(--text-faint);
    display: inline-flex;
    align-items: center;
    line-height: 1;
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-5px);
    transition:
      opacity 0.12s ease 0s,
      transform 0.14s ease 0s,
      color 0.18s ease 0s;
  }

  .hero-email.visible .hero-copy-btn {
    opacity: 1;
    transform: translateX(0);
    transition:
      opacity 0.2s ease 0.3s,
      transform 0.26s ease 0.24s,
      color 0.18s ease 0s;
  }

  .hero-copy-btn:hover {
    color: var(--green);
  }

  .hero-copy-btn.copied {
    color: var(--accent);
  }

  .hero-copy-btn:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Mobile email drop — hidden on desktop, revealed below the links row on mobile */
  .hero-email-drop {
    display: none;
  }

  /* ── Sections ── */
  .section {
    padding: 100px 0;
    position: relative;
  }

  .section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--green) 0%,
      var(--accent) 52%,
      rgba(212, 168, 85, 0.22) 100%
    );
  }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 40px;
  }

  .section-header.reveal {
    transition-delay: 0.18s;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 400;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  /* ── About ── */
  .about-content {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 64px;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .about-text p {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text-dim);
  }
  .about-text p:first-child {
    color: var(--text);
    font-size: 19px;
    line-height: 1.7;
  }

  .about-sidebar {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-left: 48px;
    border-left: 1px solid var(--border);
  }

  .detail-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .detail-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
  }
  .detail-value {
    font-size: 15px;
    color: var(--text);
    line-height: 1.5;
  }
  .detail-value a {
    color: var(--text);
    transition: color 0.2s ease;
  }
  .detail-value a.cert-verify-link {
    color: var(--accent);
  }
  .detail-value a:hover {
    color: var(--green);
  }
  .cert-verify-link {
    display: inline-flex;
    flex-direction: column;
    color: var(--accent);
  }
  .cert-verify-row {
    font-size: 12px;
    color: var(--text-faint);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .cert-verify-link .arrow {
    color: var(--accent);
    transition: transform 0.2s ease;
  }
  .cert-verify-link:hover .cert-verify-row {
    color: var(--green);
  }
  .cert-verify-link:hover .arrow {
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  /* ── Skills ── */
  .skills-table {
    display: flex;
    flex-direction: column;
  }
  .skills-row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 32px;
    padding: 22px 0;
    border-top: 1px solid rgba(92, 122, 77, 0.18);
    align-items: baseline;
  }
  .skills-row:last-child {
    border-bottom: 1px solid rgba(92, 122, 77, 0.18);
  }
  .skills-row-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--row-color, var(--green));
    padding-top: 3px;
  }
  .skills-row-items {
    font-size: 15px;
    line-height: 1.65;
  }
  .skills-item {
    color: var(--text-dim);
  }
  .skills-item--anchor {
    color: var(--text);
  }
  .skills-sep {
    color: var(--row-color, var(--green));
    opacity: 0.45;
  }

  /* ── Experience ── */
  .exp-list {
    display: flex;
    flex-direction: column;
  }

  .exp-item {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 40px;
    padding: 40px 0;
    position: relative;
  }
  .exp-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 20%;
    width: 60%;
    height: 1px;
    background: var(--text-faint);
  }
  .exp-item:last-child::after { display: none; }

  .exp-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 4px;
  }
  .exp-dates {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
    letter-spacing: 0.02em;
  }
  .exp-company {
    font-size: 14px;
    color: var(--text-dim);
    margin-top: 2px;
  }
  .exp-location {
    font-size: 12px;
    color: var(--text-faint);
  }

  .exp-body h3 {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 400;
    color: var(--text);
    margin-bottom: 14px;
    letter-spacing: -0.01em;
  }

  .exp-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .exp-bullets li {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-dim);
    padding-left: 16px;
    position: relative;
  }
  .exp-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 4px;
    height: 4px;
    background: var(--accent);
    border-radius: 1px;
  }

  /* ── Projects ── */
  .projects-list {
    display: flex;
    flex-direction: column;
  }

  .project-item {
    padding: 40px 0;
    position: relative;
  }
  .project-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 20%;
    width: 60%;
    height: 1px;
    background: var(--text-faint);
  }
  .project-item:last-child::after { display: none; }

  .project-top {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 10px;
  }

  .project-name {
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 400;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .project-status {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 3px;
    flex-shrink: 0;
  }
  @keyframes status-active-pulse {
    0%, 100% {
      background: rgba(212, 168, 85, 0.22);
      border-color: rgba(212, 168, 85, 0.38);
    }
    50% {
      background: rgba(92, 122, 77, 0.32);
      border-color: rgba(92, 122, 77, 0.36);
    }
  }

  .project-status.active {
    color: var(--text);
    border: 1px solid rgba(212, 168, 85, 0.38);
    animation: status-active-pulse 3.6s ease-in-out infinite;
  }
  .project-status.complete {
    color: var(--text);
    background: linear-gradient(
      90deg,
      rgba(92, 122, 77, 0.42) 0%,
      rgba(212, 168, 85, 0.34) 52%,
      rgba(212, 168, 85, 0.14) 100%
    );
    border: 1px solid rgba(212, 168, 85, 0.32);
  }

  .project-tagline {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text);
    margin-bottom: 16px;
  }

  .project-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
  }
  .project-bullets li {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-dim);
    padding-left: 16px;
    position: relative;
  }
  .project-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 4px;
    height: 4px;
    background: var(--accent);
    border-radius: 1px;
  }

  .project-links {
    display: flex;
    gap: 20px;
    flex-shrink: 0;
  }
  .project-link {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: color 0.2s ease;
    white-space: nowrap;
  }
  .project-link:hover { color: var(--green); }
  .project-link .arrow { transition: transform 0.2s ease; }
  .project-link:hover .arrow { transform: translate(2px, -2px); color: var(--accent); }

  /* ── Project action row (details toggle + links on same line) ── */
  .project-action-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 24px;
  }

  .project-detail-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.07em;
    text-transform: lowercase;
    color: var(--green);
    padding: 0;
    transition: color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .project-detail-toggle:hover {
    color: var(--accent);
  }
  .project-detail-toggle.open {
    color: var(--accent);
  }
  .project-detail-toggle:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .project-detail-chevron {
    flex-shrink: 0;
    transition: transform 0.32s cubic-bezier(0.2, 0.78, 0.2, 1);
  }
  .project-detail-toggle.open .project-detail-chevron {
    transform: rotate(180deg);
  }

  /* ── Project detail panel ── */
  .project-detail {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .project-detail.open {
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.42s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .project-detail-inner {
    min-height: 0;
    overflow: hidden;
  }
  .project-detail-content {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 18px 20px 20px;
    background: var(--bg-surface);
    border: 1px solid rgba(212, 168, 85, 0.16);
    border-radius: 3px;
    margin-top: 14px;
    position: relative;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    opacity: 0;
    transition: opacity 0.16s ease;
  }
  .project-detail.open .project-detail-content {
    opacity: 1;
    transition: opacity 0.15s ease;
  }

  /* Corner tick marks — amber L-brackets at top-left and bottom-right */
  .project-detail-content::before,
  .project-detail-content::after {
    content: '';
    position: absolute;
    width: 8px;
    height: 8px;
    pointer-events: none;
  }
  .project-detail-content::before {
    top: -1px;
    left: -1px;
    border-top: 1px solid rgba(212, 168, 85, 0.45);
    border-left: 1px solid rgba(212, 168, 85, 0.45);
  }
  .project-detail-content::after {
    bottom: -1px;
    right: -1px;
    border-bottom: 1px solid rgba(212, 168, 85, 0.45);
    border-right: 1px solid rgba(212, 168, 85, 0.45);
  }

  /* Staggered section reveal */
  @keyframes detailSectionIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  .project-detail.open .project-detail-content > * {
    animation: detailSectionIn 0.28s ease both;
  }
  .project-detail.open .project-detail-content > *:nth-child(1) { animation-delay: 0.08s; }
  .project-detail.open .project-detail-content > *:nth-child(2) { animation-delay: 0.18s; }
  .project-detail.open .project-detail-content > *:nth-child(3) { animation-delay: 0.28s; }
  .project-detail.open .project-detail-content > *:nth-child(4) { animation-delay: 0.36s; }

  /* Stat ledger */
  .stat-ledger {
    display: grid;
    margin-bottom: 8px;
  }
  .stat-row {
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 20px;
    align-items: baseline;
    padding: 8px 0;
    border-top: 1px solid rgba(92, 122, 77, 0.13);
  }
  .stat-row:last-child {
    border-bottom: 1px solid rgba(92, 122, 77, 0.13);
  }
  .stat-value {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    text-align: right;
    letter-spacing: 0.04em;
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--text-dim);
  }

  /* Sections */
  .project-detail-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .project-detail-section + .project-detail-section {
    padding-top: 18px;
    border-top: 1px solid rgba(92, 122, 77, 0.22);
  }
  /* First section after the stat ledger */
  .stat-ledger + .project-detail-section {
    border-top: none;
    padding-top: 0;
  }

  .project-detail-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .project-detail-desc {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 15px;
    line-height: 1.78;
    color: var(--text);
    max-width: 680px;
  }

  .project-detail-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .project-detail-bullets li {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-dim);
    padding-left: 16px;
    position: relative;
  }
  .project-detail-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 4px;
    height: 4px;
    background: var(--accent);
    border-radius: 1px;
  }

  .project-detail-decisions {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .project-detail-decisions li {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 10px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-dim);
  }
  .decision-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--green);
