---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Aaron Altergott',
  description = 'Operations engineer building cloud, AI, and automation systems. Based in Redlands, CA.',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://aaronaltergott.cv');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=5" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&family=Source+Sans+3:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Film grain overlay -->
    <div
      id="grain-overlay"
      aria-hidden="true"
      style="position:fixed;inset:0;z-index:9000;pointer-events:none;opacity:0.04;mix-blend-mode:overlay;background-image:url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22512%22 height=%22512%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.7%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3CfeColorMatrix type=%22saturate%22 values=%220%22/%3E%3C/filter%3E%3Crect width=%22512%22 height=%22512%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');background-repeat:repeat;background-size:256px 256px;"
    ></div>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --bg-deep:    #0b110d;
    --bg-surface: #131e15;
    --bg-card:    #1a2b1d;
    --tan:        #c9a96e;
    --tan-dim:    #a08450;
    --tan-light:  #e0cda0;
    --green:      #4a7a3d;
    --green-dim:  #2a5e42;
    --green-light:#5aad7e;
    --text:       #dcd5c4;
    --text-dim:   #8a8475;
    --text-faint: #5a5548;
    --border:     #243026;
    --font-heading: 'Instrument Serif', Georgia, serif;
    --font-body:    'Source Sans 3', system-ui, sans-serif;
    --font-mono:    'DM Mono', 'Menlo', monospace;
  }

  html {
    font-size: 16px;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    background: var(--bg-deep);
    color: var(--text);
    font-family: var(--font-body);
    line-height: 1.6;
    overflow-x: hidden;
  }

  ::selection {
    background: var(--tan);
    color: var(--bg-deep);
  }

  a {
    color: var(--tan);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  a:hover { color: var(--tan-light); }

  a:focus-visible {
    outline: 2px solid var(--tan);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* ── Layout ── */
  .page-wrapper {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 80px);
  }

  /* ── Nav ── */
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 20px clamp(24px, 5vw, 80px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    background: rgba(11, 17, 13, 0.85);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }
  .site-nav.scrolled {
    border-bottom-color: var(--border);
  }

  .nav-name {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--tan);
    text-transform: uppercase;
  }

  .nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
  }
  .nav-links a {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    text-transform: lowercase;
    transition: color 0.2s ease;
  }
  .nav-links a:hover { color: var(--tan); }

  /* ── Hero ── */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 80px;
    gap: 24px;
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green);
  }

  .hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(52px, 9vw, 100px);
    line-height: 1.0;
    font-weight: 400;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--tan);
  }

  .hero-sub {
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.65;
    color: var(--text-dim);
    max-width: 520px;
  }

  .hero-links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .hero-link {
    appearance: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--tan-dim);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 0;
    border-bottom: 1px solid transparent;
    transition: all 0.2s ease;
  }
  .hero-link:hover {
    color: var(--green);
    border-bottom-color: var(--tan-dim);
  }
  .hero-link .arrow {
    transition: transform 0.2s ease;
  }

  .hero-email {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .hero-email-address {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateX(-6px);
    transition:
      max-width 0.32s ease,
      opacity 0.22s ease,
      transform 0.32s ease;
    white-space: nowrap;
  }

  .hero-email.visible .hero-email-address {
    max-width: 220px;
    opacity: 1;
    transform: translateX(0);
  }

  .hero-email.visible .arrow {
    transform: rotate(90deg);
  }

  /* ── Sections ── */
  .section {
    padding: 120px 0 80px;
    position: relative;
  }

  .section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--green-dim) 0%,
      var(--tan-dim) 52%,
      rgba(201, 169, 110, 0.22) 100%
    );
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.95s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .section:has(.section-header.visible)::before {
    transform: scaleX(1);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 56px;
  }

  .section-header.reveal {
    transition-delay: 0.18s;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 400;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  /* ── About ── */
  .about-content {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 64px;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .about-text p {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text-dim);
  }
  .about-text p:first-child {
    color: var(--text);
    font-size: 19px;
    line-height: 1.7;
  }

  .about-sidebar {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-left: 48px;
    border-left: 1px solid var(--border);
  }

  .detail-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .detail-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
  }
  .detail-value {
    font-size: 15px;
    color: var(--text);
    line-height: 1.5;
  }
  .detail-value a {
    color: var(--text);
    border-bottom: 1px solid var(--border);
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .detail-value a:hover {
    color: var(--tan);
    border-bottom-color: var(--tan-dim);
  }

  /* ── Skills System ── */
  .skills-system {
    display: grid;
    grid-template-columns: minmax(460px, 1fr) minmax(320px, 420px);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
    min-height: clamp(560px, 70vh, 720px);
    padding: clamp(20px, 3vw, 36px) 0;
  }
  .skills-system.atlas-open {
    min-height: clamp(560px, 70vh, 720px);
  }

  .skills-orbit {
    position: relative;
    min-height: clamp(500px, 58vw, 660px);
    isolation: isolate;
  }
  .skills-system.atlas-open .skills-orbit {
    min-height: clamp(500px, 58vw, 660px);
  }

  .skills-orbit::before {
    content: '';
    position: absolute;
    inset: 9%;
    z-index: -1;
    background:
      linear-gradient(rgba(61, 133, 96, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(61, 133, 96, 0.055) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: radial-gradient(circle, #000 0 58%, transparent 75%);
    opacity: 0.55;
  }

  .skills-orbit-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .skills-ring {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .skills-ring.outer {
    stroke: rgba(61, 133, 96, 0.22);
    stroke-width: 0.32;
    stroke-dasharray: 1.6 2.2;
  }
  .skills-ring.inner {
    stroke: rgba(201, 169, 110, 0.16);
    stroke-width: 0.22;
  }

  .skill-vector {
    stroke: rgba(61, 133, 96, 0.18);
    stroke-width: 0.24;
    stroke-dasharray: 74;
    stroke-dashoffset: 74;
    vector-effect: non-scaling-stroke;
    transition:
      stroke 0.25s ease,
      stroke-width 0.25s ease,
      stroke-dashoffset 0.42s ease var(--skill-vector-delay);
  }
  .skill-vector.active {
    stroke: rgba(201, 169, 110, 0.78);
    stroke-width: 0.55;
    stroke-dashoffset: 0;
  }

  .skills-core {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: clamp(142px, 18vw, 190px);
    aspect-ratio: 1;
    padding: 18px;
    transform: translate(-50%, -50%);
    color: var(--text);
    border: 1px solid rgba(61, 133, 96, 0.34);
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 22%, rgba(201, 169, 110, 0.13), transparent 34%),
      rgba(11, 17, 13, 0.88);
    box-shadow:
      inset 0 0 36px rgba(61, 133, 96, 0.12),
      0 0 60px rgba(61, 133, 96, 0.08);
    text-align: center;
    cursor: pointer;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease,
      background 0.25s ease;
  }
  .skills-core:hover,
  .skills-core:focus-visible,
  .skills-core.active {
    border-color: rgba(201, 169, 110, 0.62);
    background:
      radial-gradient(circle at 50% 22%, rgba(201, 169, 110, 0.18), transparent 36%),
      rgba(13, 22, 16, 0.94);
    box-shadow:
      inset 0 0 42px rgba(61, 133, 96, 0.16),
      0 0 70px rgba(201, 169, 110, 0.08);
    transform: translate(-50%, -50%) scale(1.035);
  }
  .skills-core span,
  .skills-core small {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
  }
  .skills-core strong {
    margin: -4px 0;
    font-family: var(--font-heading);
    font-size: clamp(48px, 7vw, 72px);
    font-weight: 400;
    line-height: 0.9;
    color: var(--tan);
  }
  .skills-core small {
    color: var(--text-faint);
  }
  .skills-core.active strong {
    font-size: clamp(36px, 5vw, 54px);
    font-style: italic;
  }

  .skill-node {
    position: absolute;
    left: var(--skill-x);
    top: var(--skill-y);
    z-index: 2;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 10px;
    width: clamp(168px, 18vw, 230px);
    min-height: 58px;
    padding: 11px 14px;
    color: var(--text-dim);
    background: rgba(19, 30, 21, 0.9);
    border: 1px solid rgba(61, 133, 96, 0.24);
    border-radius: 6px;
    box-shadow:
      inset 0 1px 0 rgba(220, 213, 196, 0.04),
      0 14px 42px rgba(0, 0, 0, 0.2);
    transform: translate(-50%, -50%);
    cursor: pointer;
    animation: skill-node-in 0.55s ease both;
    animation-delay: var(--skill-delay);
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .skills-system.atlas-open .skill-node {
    align-content: start;
    min-height: 150px;
    padding-bottom: 16px;
  }
  .skill-node::before {
    content: none;
  }
  .skill-node:hover,
  .skill-node:focus-visible,
  .skill-node.active {
    color: var(--text);
    border-color: rgba(201, 169, 110, 0.52);
    background: rgba(26, 43, 29, 0.96);
    box-shadow:
      inset 0 1px 0 rgba(201, 169, 110, 0.11),
      0 18px 46px rgba(0, 0, 0, 0.28),
      0 0 34px rgba(201, 169, 110, 0.06);
    transform: translate(-50%, -50%) translateY(-2px);
  }
  .skill-node:hover::before,
  .skill-node:focus-visible::before,
  .skill-node.active::before {
    content: none;
  }

  .skill-node-count {
    font-family: var(--font-mono);
    font-size: 18px;
    line-height: 1;
    color: rgba(201, 169, 110, 0.76);
  }
  .skill-node-label {
    min-width: 0;
    font-family: var(--font-heading);
    font-size: clamp(20px, 2.2vw, 27px);
    line-height: 1.05;
    color: currentColor;
  }
  .skill-node-map {
    display: none;
  }
  .skills-system.atlas-open .skill-node-map {
    display: grid;
    grid-column: 1 / -1;
    gap: 5px;
    margin-top: 10px;
    padding-top: 11px;
    border-top: 1px solid rgba(61, 133, 96, 0.2);
    font-family: var(--font-mono);
    font-size: 9.5px;
    line-height: 1.35;
    color: var(--text-dim);
    text-align: left;
  }
  .skills-system.atlas-open .skill-node-map span {
    position: relative;
    display: block;
    min-width: 0;
    padding-left: 12px;
    overflow-wrap: anywhere;
  }
  .skills-system.atlas-open .skill-node-map span::before {
    content: '/';
    position: absolute;
    left: 0;
    color: rgba(201, 169, 110, 0.58);
  }
  .skills-system.atlas-open .skill-node-map span:not(:last-child)::after {
    content: none;
  }

  .skills-detail-panel {
    position: relative;
    padding: clamp(26px, 3vw, 36px);
    border: 1px solid rgba(61, 133, 96, 0.24);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(201, 169, 110, 0.06), transparent 34%),
      rgba(19, 30, 21, 0.78);
    box-shadow: inset 0 1px 0 rgba(220, 213, 196, 0.04);
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    transform-origin: 0 45%;
    visibility: visible;
    transition:
      clip-path 460ms cubic-bezier(0.2, 0.78, 0.2, 1),
      filter 460ms cubic-bezier(0.2, 0.78, 0.2, 1),
      opacity 360ms ease,
      transform 480ms cubic-bezier(0.18, 0.88, 0.2, 1),
      visibility 0ms linear 0ms;
    will-change: clip-path, filter, opacity, transform;
    clip-path: inset(0 round 8px);
    z-index: 1;
  }
  .skills-detail-panel::after {
    content: '';
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(61, 133, 96, 0.11);
    border-radius: 5px;
    pointer-events: none;
  }

  .skills-detail-panel.returning {
    clip-path: inset(43% 47% 43% 47% round 999px);
    filter: blur(3px) saturate(1.2);
    opacity: 0;
    pointer-events: none;
    transform: translate3d(calc(-100% - 10px), 64px, 0) scale(0.06);
    visibility: hidden;
    animation: detail-suck-desktop 500ms cubic-bezier(0.18, 0.88, 0.2, 1) both;
    transition:
      clip-path 460ms cubic-bezier(0.2, 0.78, 0.2, 1),
      filter 460ms cubic-bezier(0.2, 0.78, 0.2, 1),
      opacity 360ms ease 80ms,
      transform 480ms cubic-bezier(0.18, 0.88, 0.2, 1),
      visibility 0ms linear 500ms;
  }

  @keyframes detail-suck-desktop {
    0% {
      clip-path: inset(0 round 8px);
      filter: blur(0) saturate(1);
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
    48% {
      clip-path: inset(36% 42% 36% 42% round 999px);
      filter: blur(1.8px) saturate(1.12);
      opacity: 0.26;
      transform: translate3d(0, 0, 0) scale(0.2);
    }
    70% {
      clip-path: inset(40% 45% 40% 45% round 999px);
      filter: blur(2.4px) saturate(1.16);
      opacity: 0.12;
      transform: translate3d(0, 0, 0) scale(0.12);
    }
    100% {
      clip-path: inset(43% 47% 43% 47% round 999px);
      filter: blur(3px) saturate(1.2);
      opacity: 0;
      transform: translate3d(calc(-100% - 10px), 64px, 0) scale(0.06);
    }
  }

  .skills-detail-kicker {
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
  }
  .skills-detail-panel h3 {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 400;
    line-height: 0.98;
    color: var(--tan);
  }

  .skill-ledger {
    display: grid;
    gap: 0;
    margin-top: 28px;
    list-style: none;
    counter-reset: none;
  }
  .skill-ledger li {
    display: grid;
    grid-template-columns: 34px 1fr;
    align-items: baseline;
    gap: 16px;
    padding: 11px 0;
    border-top: 1px solid rgba(61, 133, 96, 0.18);
    animation: skill-line-in 0.36s ease both;
    animation-delay: var(--skill-delay);
  }
  .skill-ledger li:last-child {
    border-bottom: 1px solid rgba(61, 133, 96, 0.18);
  }
  .skill-ledger span {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--green);
  }
  .skill-ledger strong {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--text);
  }

  @keyframes skill-node-in {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  @keyframes skill-line-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Experience ── */
  .exp-list {
    display: flex;
    flex-direction: column;
  }

  .exp-item {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 40px;
    padding: 40px 0;
    position: relative;
  }
  .exp-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 20%;
    width: 60%;
    height: 1px;
    background: var(--border);
  }
  .exp-item:last-child::after { display: none; }

  .exp-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 4px;
  }
  .exp-dates {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
    letter-spacing: 0.02em;
  }
  .exp-company {
    font-size: 14px;
    color: var(--text-dim);
    margin-top: 2px;
  }
  .exp-location {
    font-size: 12px;
    color: var(--text-faint);
  }

  .exp-body h3 {
    font-family: var(--font-heading);
