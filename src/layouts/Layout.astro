---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Aaron Altergott',
  description = 'Operations engineer building cloud, AI, and automation systems. Based in Redlands, CA.',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://aaronaltergott.cv');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=5" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --bg-deep:      #0e0d0a;
    --bg-surface:   #1a1814;
    --accent:       #d4a855;
    --green:        #5c7a4d;
    --text:         #e0daca;
    --text-dim:     #908a7c;
    --text-faint:   #5a554a;
    --border:       #2a2620;
    --font-heading: 'Libre Baskerville', Georgia, serif;
    --font-body:    'DM Mono', 'Menlo', monospace;
    --font-mono:    'DM Mono', 'Menlo', monospace;
  }

  html {
    font-size: 16px;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    background: var(--bg-deep);
    color: var(--text);
    font-family: var(--font-body);
    line-height: 1.6;
    overflow-x: hidden;
  }

  ::selection {
    background: var(--accent);
    color: var(--bg-deep);
  }

  a {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  a:hover { color: var(--green); }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* ── Layout ── */
  .page-wrapper {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 80px);
  }

  /* ── Nav ── */
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 20px clamp(24px, 5vw, 80px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    background: rgba(14, 13, 10, 0.85);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }
  .site-nav.scrolled {
    border-bottom-color: var(--border);
  }

  .nav-name {
    font-family: var(--font-heading);
    font-size: 14px;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
    font-weight: 400;
  }

  .nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
  }
  .nav-links a {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    text-transform: lowercase;
    transition: color 0.2s ease;
  }
  .nav-links a:hover { color: var(--green); }

  /* ── Hero ── */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 80px;
    gap: 24px;
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green);
  }

  .hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(52px, 9vw, 100px);
    line-height: 1.0;
    font-weight: 400;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .hero h1 em {
    display: inline-block;
    font-style: italic;
    color: var(--accent);
    line-height: 1.08;
    margin-left: -0.045em;
    padding-left: 0.045em;
  }

  .hero-sub {
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.65;
    color: var(--text-dim);
    max-width: 520px;
  }

  .hero-links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .hero-link {
    appearance: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 0;
    transition: color 0.2s ease;
  }
  .hero-link:hover {
    color: var(--green);
  }
  .hero-link:hover .hero-link-arrow {
    transform: translate(2px, -2px);
    color: var(--accent);
  }
  .hero-link-text {
    transition: none;
  }
  .hero-link-arrow {
    font-family: var(--font-mono);
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  .hero-email {
    display: inline-flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 10px;
    min-width: 0;
    white-space: nowrap;
  }

  .hero-email-address {
    color: var(--text-dim);
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateX(-6px);
    transition:
      max-width 0.32s ease,
      opacity 0.22s ease,
      transform 0.32s ease;
    white-space: nowrap;
  }

  .hero-email.visible .hero-email-address {
    max-width: 220px;
    opacity: 1;
    transform: translateX(0);
  }

  .hero-copy-btn {
    appearance: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 4px 3px;
    color: var(--text-faint);
    display: inline-flex;
    align-items: center;
    line-height: 1;
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-5px);
    transition:
      opacity 0.12s ease 0s,
      transform 0.14s ease 0s,
      color 0.18s ease 0s;
  }

  .hero-email.visible .hero-copy-btn {
    opacity: 1;
    transform: translateX(0);
    transition:
      opacity 0.2s ease 0.3s,
      transform 0.26s ease 0.24s,
      color 0.18s ease 0s;
  }

  .hero-copy-btn:hover {
    color: var(--green);
  }

  .hero-copy-btn.copied {
    color: var(--accent);
  }

  .hero-copy-btn:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Mobile email drop — hidden on desktop, revealed below the links row on mobile */
  .hero-email-drop {
    display: none;
  }

  /* ── Sections ── */
  .section {
    padding: 100px 0;
    position: relative;
  }

  .section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--green) 0%,
      var(--accent) 52%,
      rgba(212, 168, 85, 0.22) 100%
    );
  }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 40px;
  }

  .section-header.reveal {
    transition-delay: 0.18s;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 400;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  /* ── About ── */
  .about-content {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 64px;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .about-text p {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text-dim);
  }
  .about-text p:first-child {
    color: var(--text);
    font-size: 19px;
    line-height: 1.7;
  }

  .about-sidebar {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-left: 48px;
    border-left: 1px solid var(--border);
  }

  .detail-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .detail-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
  }
  .detail-value {
    font-size: 15px;
    color: var(--text);
    line-height: 1.5;
  }
  .detail-value a {
    color: var(--text);
    transition: color 0.2s ease;
  }
  .detail-value a.cert-verify-link {
    color: var(--accent);
  }
  .detail-value a:hover {
    color: var(--green);
  }
  .cert-verify-link {
    display: inline-flex;
    flex-direction: column;
    color: var(--accent);
  }
  .cert-verify-row {
    font-size: 12px;
    color: var(--text-faint);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .cert-verify-link .arrow {
    color: var(--accent);
    transition: transform 0.2s ease;
  }
  .cert-verify-link:hover .cert-verify-row {
    color: var(--green);
  }
  .cert-verify-link:hover .arrow {
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  /* ── Skills System ── */
  .skills-system {
    position: relative;
    display: grid;
    grid-template-columns: minmax(460px, 1fr) minmax(320px, 420px);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
    min-height: clamp(600px, 78vh, 800px);
    padding: clamp(20px, 3vw, 36px) 0;
  }

  .skills-orbit {
    position: relative;
    width: 100%;
    grid-column: 1;
    grid-row: 1;
    aspect-ratio: 1;
    isolation: isolate;
  }

  .skills-system.pip-open .skills-orbit-lines {
    opacity: 0.35;
  }

  .skills-orbit::before {
    content: '';
    position: absolute;
    inset: 9%;
    z-index: -1;
    background:
      linear-gradient(rgba(92, 122, 77, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(92, 122, 77, 0.055) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: radial-gradient(circle, #000 0 58%, transparent 75%);
    opacity: 0.55;
  }

  .skills-orbit-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transition: opacity 0.35s ease;
  }

  .skills-ring {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .skills-ring.outer {
    stroke: rgba(92, 122, 77, 0.22);
    stroke-width: 0.32;
    stroke-dasharray: 1.6 2.2;
  }
  .skills-ring.inner {
    stroke: rgba(212, 168, 85, 0.16);
    stroke-width: 0.22;
  }

  .skill-vector {
    stroke: rgba(92, 122, 77, 0.18);
    stroke-width: 0.24;
    stroke-dasharray: 74;
    stroke-dashoffset: 74;
    vector-effect: non-scaling-stroke;
    transition:
      stroke 0.25s ease,
      stroke-width 0.25s ease,
      stroke-dashoffset 0.42s ease var(--skill-vector-delay);
  }
  .skill-vector.active {
    stroke: rgba(212, 168, 85, 0.78);
    stroke-width: 0.55;
    stroke-dashoffset: 0;
  }

  .skills-core {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 4;
    display: grid;
    place-items: center;
    width: clamp(142px, 18vw, 190px);
    aspect-ratio: 1;
    padding: 18px;
    transform: translate(-50%, -50%);
    color: var(--text);
    border: 1px solid rgba(92, 122, 77, 0.34);
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 22%, rgba(212, 168, 85, 0.13), transparent 34%),
      rgba(14, 13, 10, 0.88);
    box-shadow: inset 0 0 36px rgba(92, 122, 77, 0.12);
    text-align: center;
    cursor: pointer;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease,
      background 0.25s ease;
  }
  .skills-core:hover,
  .skills-core:focus-visible,
  .skills-core.active {
    border-color: rgba(212, 168, 85, 0.62);
    background:
      radial-gradient(circle at 50% 22%, rgba(212, 168, 85, 0.18), transparent 36%),
      rgba(14, 13, 10, 0.94);
    box-shadow: inset 0 0 42px rgba(92, 122, 77, 0.16);
    transform: translate(-50%, -50%) scale(1.035);
  }
  .skills-core.active {
    transform: translate(-50%, -50%);
  }
  .skills-core:active {
    transform: translate(-50%, -50%) scale(0.965);
    transition-duration: 0.08s;
  }
  .skills-core span,
  .skills-core small {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
  }
  .skills-core strong {
    margin: -4px 0;
    font-family: var(--font-heading);
    font-size: clamp(48px, 7vw, 72px);
    font-weight: 400;
    line-height: 0.9;
    color: var(--accent);
  }
  .skills-core small {
    color: var(--text-faint);
  }
  .skills-core.active strong {
    font-size: clamp(36px, 5vw, 54px);
    font-style: italic;
  }

  .skill-node {
    position: absolute;
    left: var(--skill-x);
    top: var(--skill-y);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: clamp(168px, 18vw, 230px);
    min-height: 58px;
    padding: 11px 14px;
    color: var(--text-dim);
    background: rgba(26, 24, 20, 0.9);
    border: 1px solid rgba(92, 122, 77, 0.24);
    border-radius: 6px;
    box-shadow:
      inset 0 1px 0 rgba(224, 218, 202, 0.04),
      0 14px 42px rgba(0, 0, 0, 0.2);
    transform: translate(-50%, -50%);
    cursor: default;
    animation: skill-node-in 0.55s ease both;
    animation-delay: var(--skill-delay);
    transition:
      left 0.48s cubic-bezier(0.2, 0.78, 0.2, 1),
      top 0.48s cubic-bezier(0.2, 0.78, 0.2, 1),
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .skill-node-top {
    display: grid;
    grid-template-columns: 22px 1fr 22px;
    align-items: center;
    width: 100%;
  }

  .skill-node::before {
    content: none;
  }
  .skill-node:hover,
  .skill-node:focus-visible,
  .skill-node.active {
    color: var(--text);
    border-color: rgba(212, 168, 85, 0.52);
    background: rgba(26, 24, 20, 0.96);
    box-shadow:
      inset 0 1px 0 rgba(212, 168, 85, 0.11),
      0 18px 46px rgba(0, 0, 0, 0.28),
      0 0 34px rgba(212, 168, 85, 0.06);
    transform: translate(-50%, -50%) translateY(-2px);
  }
  .skill-node:hover::before,
  .skill-node:focus-visible::before,
  .skill-node.active::before {
    content: none;
  }

  .skill-node-count {
    grid-column: 1;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 18px;
    line-height: 1;
    color: rgba(212, 168, 85, 0.76);
    opacity: 0;
    transition: opacity 0.22s ease;
  }
  .skill-node:hover .skill-node-count,
  .skill-node:focus-visible .skill-node-count,
  .skill-node.active .skill-node-count {
    opacity: 1;
  }
  .skill-node-label {
    grid-column: 2;
    font-family: var(--font-heading);
    font-size: clamp(20px, 2.2vw, 27px);
    line-height: 1.05;
    color: currentColor;
    text-align: center;
    white-space: nowrap;
  }
  .skill-node-map { display: none; }

  /* ── Pip card ── */
  .pip-card {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(92, 122, 77, 0.24);
    border-radius: 8px;
    background:
      radial-gradient(circle at 0% 48%, rgba(92, 122, 77, 0.12), transparent 34%),
      linear-gradient(135deg, rgba(212, 168, 85, 0.04), transparent 38%),
      rgba(14, 13, 10, 0.78);
    box-shadow: inset 0 1px 0 rgba(224, 218, 202, 0.04);
    overflow: hidden;
    animation: pip-card-in 0.36s cubic-bezier(0.18, 0.88, 0.2, 1) both;
  }

  @keyframes pip-card-in {
    from { opacity: 0; transform: translateX(10px) scale(0.98); }
    to   { opacity: 1; transform: translateX(0)    scale(1); }
  }

  .pip-close {
    position: absolute;
    top: 11px;
    right: 11px;
    z-index: 2;
    appearance: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 5px;
    color: var(--text-faint);
    line-height: 1;
    transition: color 0.18s ease;
  }
  .pip-close:hover { color: var(--text-dim); }
  .pip-close:focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; border-radius: 2px; }

  .pip-scroll {
    overflow-y: auto;
    max-height: min(480px, 56vh);
    padding: clamp(18px, 2.2vw, 28px);
    padding-right: clamp(22px, 2.6vw, 32px);
    padding-bottom: 10px;
    scrollbar-width: thin;
    scrollbar-color: rgba(92, 122, 77, 0.28) transparent;
  }
  .pip-scroll::-webkit-scrollbar { width: 3px; }
  .pip-scroll::-webkit-scrollbar-thumb { background: rgba(92, 122, 77, 0.28); border-radius: 2px; }

  .pip-pre {
    margin: 0;
    white-space: pre-wrap;
    font-family: var(--font-mono);
    font-size: clamp(11px, 1.05vw, 13px);
    line-height: 1.72;
    color: rgba(190, 183, 166, 0.86);
  }
  .pip-line {
    display: block;
    animation: terminal-line-in 180ms ease both;
  }
  .pip-line.command { color: rgba(236, 229, 210, 0.94); }
  .pip-line.status  { color: rgba(212, 168, 85, 0.76); }
  .pip-line.ok,
  .pip-line.success { color: rgba(132, 175, 112, 0.9); }
  .pip-line.warning { color: rgba(212, 168, 85, 0.82); }
  .pip-cursor {
    display: inline-block;
    margin-left: 2px;
    color: rgba(212, 168, 85, 0.86);
    animation: terminal-cursor 940ms steps(2, end) infinite;
  }

  .pip-input-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px clamp(18px, 2.2vw, 28px);
    border-top: 1px solid rgba(92, 122, 77, 0.15);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s ease;
  }
  .pip-input-row.active {
    opacity: 1;
    pointer-events: auto;
  }
  .pip-prompt {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    flex-shrink: 0;
    line-height: 1;
    user-select: none;
  }
  .pip-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: 0;
    font-family: var(--font-mono);
    font-size: clamp(11px, 1.05vw, 13px);
    color: var(--text);
    caret-color: var(--accent);
  }
  .pip-input::placeholder { color: var(--text-faint); }
  .pip-input:disabled { opacity: 0.4; cursor: default; }
  .pip-send {
    appearance: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 4px 6px;
    color: var(--text-faint);
    display: flex;
    align-items: center;
    flex-shrink: 0;
    transition: color 0.18s ease, transform 0.18s ease;
  }
  .pip-send:not(:disabled):hover { color: var(--accent); transform: translateX(2px); }
  .pip-send:disabled { opacity: 0.28; cursor: default; }
  .pip-send:focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; border-radius: 2px; }

  /* ── Trash can ── */
  .pip-trash {
    position: absolute;
    left: 10%;
    bottom: 11%;
    z-index: 3;
    opacity: 0;
    transform: scale(0.78) translateY(6px);
    transition: opacity 0.28s ease, transform 0.28s cubic-bezier(0.18, 0.88, 0.2, 1);
    pointer-events: none;
  }
  .pip-trash.visible {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  .trash-lid-group {
    transform-origin: 11px 9px;
  }

  /* Lid swings open with anticipation + overshoot */
  @keyframes trash-lid-open {
    0%   { transform: rotate(0deg); }
    10%  { transform: rotate(-5deg); }
    42%  { transform: rotate(-60deg); }
    62%  { transform: rotate(-38deg); }
    80%  { transform: rotate(-52deg); }
    100% { transform: rotate(-47deg); }
  }
  .pip-trash.lid-open .trash-lid-group {
    animation: trash-lid-open 0.62s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  /* Lid snaps shut — quick with a crisp settle */
  @keyframes trash-lid-close {
    0%   { transform: rotate(-47deg); }
    32%  { transform: rotate(-4deg); }
    50%  { transform: rotate(5deg); }
    68%  { transform: rotate(-1.5deg); }
    100% { transform: rotate(0deg); }
  }
  .pip-trash.lid-closing .trash-lid-group {
    animation: trash-lid-close 0.48s cubic-bezier(0.36, 0, 0.66, -0.1) forwards;
  }

  /* Can squash-and-stretch on impact */
  @keyframes trash-can-catch {
    0%   { transform: scale(1, 1) translateY(0); }
    18%  { transform: scale(1.06, 0.92) translateY(3px); }
    38%  { transform: scale(0.96, 1.06) translateY(-4px); }
    58%  { transform: scale(1.03, 0.97) translateY(2px); }
    76%  { transform: scale(0.99, 1.01) translateY(-1px); }
    100% { transform: scale(1, 1) translateY(0); }
  }
  /* Amber flash on the SVG strokes when the plane is swallowed */
  @keyframes trash-catch-glow {
    0%   { filter: none; }
    20%  { filter: drop-shadow(0 0 5px rgba(212, 168, 85, 0.55)) brightness(1.18); }
    55%  { filter: drop-shadow(0 0 2px rgba(212, 168, 85, 0.22)); }
    100% { filter: none; }
  }
  .pip-trash.catching {
    animation: trash-can-catch 0.52s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  .pip-trash.catching svg {
    animation: trash-catch-glow 0.58s ease forwards;
  }

  .skills-detail-panel {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    padding: clamp(26px, 3vw, 36px);
    border: 1px solid rgba(92, 122, 77, 0.24);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(212, 168, 85, 0.06), transparent 34%),
      rgba(26, 24, 20, 0.78);
    box-shadow: inset 0 1px 0 rgba(224, 218, 202, 0.04);
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    transform-origin: 0 45%;
    visibility: visible;
    transition:
      clip-path 460ms cubic-bezier(0.2, 0.78, 0.2, 1),
      filter 460ms cubic-bezier(0.2, 0.78, 0.2, 1),
      opacity 360ms ease,
      transform 480ms cubic-bezier(0.18, 0.88, 0.2, 1),
      visibility 0ms linear 0ms;
    will-change: clip-path, filter, opacity, transform;
    clip-path: inset(0 round 8px);
    z-index: 1;
  }
  .skills-detail-kicker {
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
  }
  .skills-detail-panel h3 {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 400;
    line-height: 0.98;
    color: var(--accent);
  }

  .skill-ledger {
    display: grid;
    gap: 0;
    margin-top: 28px;
    list-style: none;
    counter-reset: none;
  }
  .skill-ledger li {
    display: grid;
    grid-template-columns: 34px 1fr;
    align-items: baseline;
    gap: 16px;
    padding: 11px 0;
    border-top: 1px solid rgba(92, 122, 77, 0.18);
    animation: skill-line-in 0.36s ease both;
    animation-delay: var(--skill-delay);
  }
  .skill-ledger li:last-child {
    border-bottom: 1px solid rgba(92, 122, 77, 0.18);
  }
  .skill-ledger span {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--green);
  }
  .skill-ledger strong {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--text);
  }

  @keyframes skill-node-in {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  @keyframes skill-line-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes terminal-line-in {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes terminal-cursor {
    0%, 42% { opacity: 1; }
    43%, 100% { opacity: 0; }
  }

  @keyframes ring-rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* ── Experience ── */
  .exp-list {
    display: flex;
    flex-direction: column;
  }

  .exp-item {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 40px;
    padding: 40px 0;
    position: relative;
  }
  .exp-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 20%;
    width: 60%;
    height: 1px;
    background: var(--text-faint);
  }
  .exp-item:last-child::after { display: none; }

  .exp-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 4px;
  }
  .exp-dates {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
    letter-spacing: 0.02em;
  }
  .exp-company {
    font-size: 14px;
    color: var(--text-dim);
    margin-top: 2px;
  }
  .exp-location {
    font-size: 12px;
    color: var(--text-faint);
  }

  .exp-body h3 {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 400;
    color: var(--text);
    margin-bottom: 14px;
    letter-spacing: -0.01em;
  }

  .exp-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .exp-bullets li {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-dim);
    padding-left: 16px;
    position: relative;
  }
  .exp-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 4px;
    height: 4px;
    background: var(--accent);
    border-radius: 1px;
  }

  /* ── Projects ── */
  .projects-list {
    display: flex;
    flex-direction: column;
  }

  .project-item {
    padding: 40px 0;
    position: relative;
  }
  .project-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 20%;
    width: 60%;
    height: 1px;
    background: var(--text-faint);
  }
  .project-item:last-child::after { display: none; }

  .project-top {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 10px;
  }

  .project-name {
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 400;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .project-status {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 3px;
    flex-shrink: 0;
  }
  .project-status.active {
    color: var(--accent);
    background: rgba(92, 122, 77, 0.14);
  }
  .project-status.complete {
    color: var(--text);
    background: linear-gradient(
      90deg,
      rgba(92, 122, 77, 0.42) 0%,
      rgba(212, 168, 85, 0.34) 52%,
      rgba(212, 168, 85, 0.14) 100%
    );
    border: 1px solid rgba(212, 168, 85, 0.32);
  }

  .project-tagline {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text);
    margin-bottom: 16px;
  }

  .project-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
  }
  .project-bullets li {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-dim);
    padding-left: 16px;
    position: relative;
  }
  .project-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 4px;
    height: 4px;
    background: var(--accent);
    border-radius: 1px;
  }

  .project-links {
    display: flex;
    gap: 20px;
    flex-shrink: 0;
  }
  .project-link {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: color 0.2s ease;
    white-space: nowrap;
  }
  .project-link:hover { color: var(--green); }
  .project-link .arrow { transition: transform 0.2s ease; }
  .project-link:hover .arrow { transform: translate(2px, -2px); color: var(--accent); }

  /* ── Project action row (details toggle + links on same line) ── */
  .project-action-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 24px;
  }

  .project-detail-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.07em;
    text-transform: lowercase;
    color: var(--green);
    padding: 0;
    transition: color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .project-detail-toggle:hover {
    color: var(--accent);
  }
  .project-detail-toggle.open {
    color: var(--accent);
  }
  .project-detail-toggle:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .project-detail-chevron {
    flex-shrink: 0;
    transition: transform 0.32s cubic-bezier(0.2, 0.78, 0.2, 1);
  }
  .project-detail-toggle.open .project-detail-chevron {
    transform: rotate(180deg);
  }

  /* ── Project detail panel ── */
  .project-detail {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .project-detail.open {
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.42s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .project-detail-inner {
    min-height: 0;
    overflow: hidden;
  }
  .project-detail-content {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 18px 20px 20px;
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid var(--border);
    border-radius: 3px;
    margin-top: 14px;
    position: relative;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    opacity: 0;
    transition: opacity 0.16s ease;
  }
  .project-detail.open .project-detail-content {
    opacity: 1;
    transition: opacity 0.15s ease;
  }

  /* Corner tick marks — amber L-brackets at top-left and bottom-right */
  .project-detail-content::before,
  .project-detail-content::after {
    content: '';
    position: absolute;
    width: 8px;
    height: 8px;
    pointer-events: none;
  }
  .project-detail-content::before {
    top: -1px;
    left: -1px;
    border-top: 1px solid rgba(212, 168, 85, 0.45);
    border-left: 1px solid rgba(212, 168, 85, 0.45);
  }
  .project-detail-content::after {
    bottom: -1px;
    right: -1px;
    border-bottom: 1px solid rgba(212, 168, 85, 0.45);
    border-right: 1px solid rgba(212, 168, 85, 0.45);
  }

  /* Staggered section reveal */
  @keyframes detailSectionIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  .project-detail.open .project-detail-content > * {
    animation: detailSectionIn 0.28s ease both;
  }
  .project-detail.open .project-detail-content > *:nth-child(1) { animation-delay: 0.08s; }
  .project-detail.open .project-detail-content > *:nth-child(2) { animation-delay: 0.18s; }
  .project-detail.open .project-detail-content > *:nth-child(3) { animation-delay: 0.28s; }

  /* Stat ledger */
  .stat-ledger {
    display: grid;
    margin-bottom: 8px;
  }
  .stat-row {
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 20px;
    align-items: baseline;
    padding: 8px 0;
    border-top: 1px solid rgba(92, 122, 77, 0.13);
  }
  .stat-row:last-child {
    border-bottom: 1px solid rgba(92, 122, 77, 0.13);
  }
  .stat-value {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    text-align: right;
    letter-spacing: 0.04em;
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--text-dim);
  }

  /* Sections */
  .project-detail-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .project-detail-section + .project-detail-section {
    padding-top: 18px;
    border-top: 1px solid rgba(92, 122, 77, 0.10);
  }
  /* First section after the stat ledger */
  .stat-ledger + .project-detail-section {
    border-top: none;
    padding-top: 0;
  }

  .project-detail-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--green);
  }
  .project-detail-desc {
    font-size: 15px;
    line-height: 1.78;
    color: var(--text-dim);
    padding-left: 14px;
    border-left: 1px solid rgba(212, 168, 85, 0.22);
    max-width: 680px;
  }

  .project-detail-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .project-detail-bullets li {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-dim);
    padding-left: 16px;
    position: relative;
  }
  .project-detail-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 4px;
    height: 4px;
    background: var(--accent);
    border-radius: 1px;
  }

  .project-detail-decisions {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .project-detail-decisions li {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 10px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-dim);
  }
  .decision-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--green);
    padding-top: 2px;
    flex-shrink: 0;
    line-height: 1;
  }

  /* ── Contact ── */
  .contact-content {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .contact-cta {
    font-family: var(--font-heading);
    font-size: clamp(14px, 1.5vw, 18px);
    font-weight: 500;
    color: var(--text-muted, #888);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 28px;
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .contact-item-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
  }
  .contact-item a,
  .contact-item span:not(.contact-item-label) {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--text);
  }
  .contact-item a {
    align-self: flex-start;
    transition: color 0.2s ease;
  }
  .contact-item a:hover {
    color: var(--green);
  }
  .contact-item a:hover .contact-ext-arrow {
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  .resume-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 10px 20px;
    border-radius: 4px;
    align-self: flex-start;
    transition: all 0.2s ease;
  }
  .resume-link:hover {
    color: var(--green);
    border-color: var(--accent);
    background: rgba(212, 168, 85, 0.06);
  }

  /* ── Footer ── */
  .site-footer {
    padding: 40px 0;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .footer-text {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.04em;
  }
  .contact-email-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .contact-ext-arrow {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    display: inline-block;
    transition: transform 0.2s ease;
  }

  /* ── Scroll Progress Bar ── */
  .scroll-progress-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      var(--green) 0%,
      var(--accent) 50%,
      rgba(212, 168, 85, 0.35) 100%
    );
    transform: scaleX(var(--scroll-progress, 0));
    transform-origin: center;
    opacity: 0.75;
  }

  /* ── Uptime Chip ── */
  .uptime-chip {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.03em;
    color: var(--accent);
    opacity: 0.65;
  }

  /* ── Scroll Reveals ── */
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.65s ease, transform 0.65s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Hamburger button ── */
  .nav-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: transparent;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .nav-hamburger span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--text-dim);
    border-radius: 1px;
    transform-origin: center;
    transition: transform 0.25s ease, opacity 0.2s ease, background 0.2s ease;
  }
  .nav-hamburger:hover span { background: var(--accent); }
  .nav-hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .nav-hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .nav-hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* ── Mobile menu drawer ── */
  .mobile-menu {
    display: none;
    position: fixed;
    top: 84px; /* mobile nav height: 20px padding + 44px hamburger + 20px padding */
    left: 0;
    right: 0;
    z-index: 99;
    background: rgba(14, 13, 10, 0.97);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    transform: translateY(-8px);
    opacity: 0;
    transition: transform 0.25s ease, opacity 0.2s ease;
    pointer-events: none;
  }
  .mobile-menu.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mobile-nav-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    padding: 8px 0 16px;
  }
  .mobile-nav-links a {
    display: block;
    padding: 14px clamp(24px, 5vw, 80px);
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    text-transform: lowercase;
    border-bottom: 1px solid var(--border);
    transition: color 0.2s ease, background 0.2s ease;
  }
  .mobile-nav-links li:last-child a { border-bottom: none; }
  .mobile-nav-links a:hover { color: var(--green); background: rgba(212, 168, 85, 0.04); }

  .mobile-menu-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 98;
    background: rgba(8, 7, 6, 0.4);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .skills-system {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 24px;
    }
    .skills-orbit {
      max-width: 520px;
      min-height: 0;
      margin: 0 auto;
    }
    .skills-detail-panel,
    .pip-card {
      grid-column: 1;
      grid-row: 2;
      max-width: none;
      width: 100%;
    }
    .about-content {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .about-sidebar {
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--border);
      padding-top: 40px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      row-gap: 32px;
      column-gap: 24px;
    }
  }

  @media (max-width: 700px) {
    .skills-system:not(.pip-open) {
      gap: 12px;
    }
    .skills-orbit {
      aspect-ratio: auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
