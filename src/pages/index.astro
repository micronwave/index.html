---
import Layout from '../layouts/Layout.astro';
import { person, about, experience, projects, skills, education, certifications } from '../data/content';
import PortfolioInterface from '../components/PortfolioInterface';
---

<Layout>
  <PortfolioInterface
    client:load
    person={person}
    about={about}
    experience={experience}
    projects={projects}
    skills={skills}
    education={education}
    certifications={certifications}
  />
</Layout>
