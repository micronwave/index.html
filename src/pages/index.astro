---
import Layout from '../layouts/Layout.astro';
import { person, about, experience, projects, education, certifications } from '../data/content';
import PortfolioInterface from '../components/PortfolioInterface';
import AboutSection from '../components/sections/AboutSection';
import ContactSection from '../components/sections/ContactSection';
import EducationSection from '../components/sections/EducationSection';
import ExperienceSection from '../components/sections/ExperienceSection';
import ProjectsSection from '../components/sections/ProjectsSection';
---

<Layout>
  <PortfolioInterface
    client:load
    person={person}
    about={about}
    experience={experience}
    projects={projects}
    education={education}
    certifications={certifications}
  />
  <noscript>
    <main class="noscript-content">
      <header>
        <h1>{person.name}</h1>
        <p>{person.tagline}</p>
      </header>
      <AboutSection about={about} />
      <ExperienceSection experience={experience} />
      <ProjectsSection projects={projects} />
      <EducationSection education={education} certifications={certifications} />
      <ContactSection person={person} />
    </main>
  </noscript>
</Layout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    overflow: hidden;
  }

  :global(.interface-shell) {
    position: relative;
    min-height: 100dvh;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-bg);
  }

  :global(.interface-shell::before) {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 50%, rgba(61, 133, 96, 0.03) 0%, transparent 55%),
      radial-gradient(ellipse at center, transparent 35%, #060d08 100%);
    pointer-events: none;
    z-index: -1;
  }

  .noscript-content {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .noscript-content header {
    padding: 2rem 0 3rem;
  }

  :global(.orbit-stage) {
    position: relative;
    display: grid;
    grid-template-columns: min(22%, 280px) 1fr min(30%, 420px);
    width: 100%;
    height: 100dvh;
    min-height: 40rem;
  }

  /* Column 1: Navigation sidebar */
  :global(.nav-rail) {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.75rem, 4vh, 3.5rem);
    padding: clamp(3rem, 6vh, 5.5rem) 0.75rem clamp(3rem, 6vh, 5.5rem) clamp(1.25rem, 2.5vw, 2.5rem);
    height: 100%;
  }

  /* Column 2: Embedded content area */
  :global(.content-column) {
    position: relative;
  }

  :global(.content-column::before) {
    content: '';
    position: absolute;
    inset: clamp(2rem, 5vh, 4rem) clamp(0.75rem, 1.5vw, 1.5rem);
    border: 1px dashed rgba(61, 133, 96, 0.07);
    border-radius: 12px;
    pointer-events: none;
    transition: opacity 300ms ease;
  }

  :global(.orbit-stage.panel-open .content-column::before) {
    opacity: 0;
  }

  /* Column 3: Identity hub */
  :global(.center-hub) {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    align-self: start;
    padding-top: clamp(4rem, 9vh, 8rem);
    padding-left: clamp(1rem, 2vw, 2rem);
    padding-right: clamp(1rem, 2vw, 2.5rem);
    transition: opacity 420ms ease;
  }

  :global(.center-hub.panel-open) {
    opacity: 0.18;
    pointer-events: none;
  }

  :global(.game-zone) {
    min-height: clamp(8rem, 18vh, 14rem);
    width: min(100%, clamp(14rem, 36vw, 34rem));
    margin-top: 0.5rem;
  }

  :global(.particle-name-canvas) {
    width: min(100%, clamp(14rem, 28vw, 36rem));
    height: clamp(4.5rem, 9vw, 8rem);
    pointer-events: auto;
  }

  :global(.hub-kicker),
  :global(.panel-kicker),
  :global(.section-kicker) {
    color: var(--color-accent);
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  :global(.hub-tagline) {
    display: inline-flex;
    flex-wrap: wrap;
    align-self: flex-end;
    justify-content: flex-end;
    gap: 0.45em;
    width: auto;
    padding-bottom: 0.6rem;
    color: var(--color-text);
    border-bottom: 1px solid rgba(61, 133, 96, 0.35);
    font-size: clamp(0.9rem, 1.6vw, 1.25rem);
    letter-spacing: 0.22em;
    opacity: 1;
    view-transition-name: hub-tagline;
    transition: opacity 280ms ease, transform 280ms ease;
  }

  :global(.hub-tagline span) {
    display: inline-block;
  }

  :global(h1) {
    color: var(--color-text);
    font-size: clamp(1.88rem, 5.6vw, 5.4rem);
    font-weight: 300;
    letter-spacing: 0.12em;
    line-height: 0.98;
    text-transform: uppercase;
    text-shadow: none;
  }

  :global(.sr-name) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    pointer-events: none;
  }

  :global(.about-tab),
  :global(.orbit-node),
  :global(.close-button),
  :global(.link-row a),
  :global(.inline-link),
  :global(.contact-link) {
    color: var(--color-text);
    font: inherit;
    text-decoration: none;
  }

  :global(.orbit-node),
  :global(.close-button),
  :global(.link-row a) {
    min-height: 44px;
    cursor: pointer;
  }

  :global(.orbit-node) {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    min-height: clamp(3rem, 5.5vh, 4.5rem);
    padding: 0.75rem 0.9rem;
    color: var(--color-text);
    background: rgba(8, 18, 12, 0.72);
    border: 1px solid rgba(61, 133, 96, 0.14);
    border-radius: 8px;
    font-family: var(--font-display);
    font-size: clamp(0.72rem, 1vw, 0.84rem);
    font-weight: 500;
    letter-spacing: 0.05em;
    line-height: 1.45;
    text-align: center;
    text-transform: uppercase;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow:
      inset 0 1px 0 rgba(61, 133, 96, 0.10),
      inset 1px 0 0 rgba(61, 133, 96, 0.05),
      0 4px 16px rgba(0, 0, 0, 0.3);
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease,
      background 200ms ease;
  }

  :global(.orbit-node:hover),
  :global(.orbit-node:focus-visible) {
    border-color: rgba(224, 213, 176, 0.35);
    background: rgba(10, 22, 14, 0.85);
    box-shadow:
      inset 0 1px 0 rgba(224, 213, 176, 0.18),
      inset 1px 0 0 rgba(224, 213, 176, 0.10),
      0 0 0 1px rgba(224, 213, 176, 0.18),
      0 8px 28px rgba(224, 213, 176, 0.10),
      0 0 44px rgba(224, 213, 176, 0.06);
  }

  :global(.orbit-node-active) {
    border-color: rgba(224, 213, 176, 0.45) !important;
    background: rgba(10, 24, 15, 0.90) !important;
    box-shadow:
      inset 0 1px 0 rgba(224, 213, 176, 0.22),
      inset 1px 0 0 rgba(224, 213, 176, 0.12),
      0 0 0 1px rgba(224, 213, 176, 0.28),
      0 8px 32px rgba(224, 213, 176, 0.14),
      0 0 60px rgba(224, 213, 176, 0.07) !important;
  }

  /* Backdrop: desktop hidden, mobile only */
  :global(.panel-backdrop) {
    position: fixed;
    inset: 0;
    z-index: 18;
    background: rgba(3, 8, 4, 0.55);
    cursor: pointer;
    display: none;
  }

  :global(.content-panel) {
    position: absolute;
    inset: clamp(2rem, 5vh, 4rem) clamp(0.75rem, 1.5vw, 1.5rem);
    z-index: 2;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    overflow: hidden;
    background: rgba(5, 11, 7, 0.95);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border: 1px solid rgba(61, 133, 96, 0.2);
    border-radius: 12px;
    box-shadow:
      inset 0 1px 0 rgba(61, 133, 96, 0.22),
      inset 1px 0 0 rgba(61, 133, 96, 0.10),
      0 32px 80px rgba(0, 0, 0, 0.65),
      0 0 80px rgba(61, 133, 96, 0.05);
  }

  :global(.panel-chrome) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem clamp(1rem, 3vw, 1.75rem);
    border-bottom: 1px solid rgba(61, 133, 96, 0.13);
  }

  :global(.close-button) {
    flex-shrink: 0;
    padding: 0.4rem 0.6rem;
    background: rgba(61, 133, 96, 0.06);
    border: 1px solid rgba(61, 133, 96, 0.15);
    border-radius: 6px;
    font-size: 1.3rem;
    line-height: 1;
    color: var(--color-text-muted);
    transition: color 180ms ease, transform 180ms ease, background 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }
  :global(.close-button:hover),
  :global(.close-button:focus-visible) {
    color: var(--color-accent);
    background: rgba(61, 133, 96, 0.12);
    border-color: rgba(61, 133, 96, 0.4);
    transform: scale(1.08);
    box-shadow: 0 0 16px rgba(61, 133, 96, 0.15);
  }

  :global(.overlay-content) {
    min-height: 0;
    overflow: auto;
    padding: 0 clamp(1rem, 3vw, 1.5rem) 1.5rem;
  }

  :global(.portfolio-section) {
    padding: 1.5rem 0 0;
    scroll-margin-top: 5rem;
  }

  :global(.section-heading) {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  :global(h2) {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.45rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  :global(h3) {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
  }

  :global(h4) {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }

  :global(.about-summary) {
    max-width: 60rem;
    color: var(--color-text);
    font-size: 1.125rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  :global(.about-summary + .about-summary) {
    margin-top: 1.25em;
  }

  :global(.card-grid) {
    display: grid;
    gap: 1rem;
  }

  :global(.content-card) {
    position: relative;
    display: grid;
    gap: 1rem;
    min-width: 0;
    padding: 1.25rem;
    background: rgba(8, 18, 12, 0.65);
    border: 1px solid rgba(61, 133, 96, 0.13);
    border-radius: 10px;
    box-shadow: inset 0 1px 0 rgba(61, 133, 96, 0.07);
  }

  :global(.content-card *),
  :global(.contact-link *) {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  :global(.project-card) {
    padding-top: 3.25rem;
  }

  :global(.card-heading) {
    display: grid;
    gap: 0.35rem;
  }

  :global(.meta-line),
  :global(.tagline-text) {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  :global(.bullet-list) {
    display: grid;
    gap: 0.65rem;
    padding-left: 1.15rem;
    color: var(--color-text);
    line-height: 1.6;
  }

  :global(.bullet-list li::marker) {
    color: var(--color-accent);
  }

  :global(.chip-row) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  :global(.chip),
  :global(.status-badge) {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1;
  }

  :global(.chip) {
    padding: 0.45rem 0.7rem;
    color: var(--color-accent);
    background: rgba(61, 133, 96, 0.07);
    border: 1px solid rgba(61, 133, 96, 0.18);
  }

  :global(.status-badge) {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    padding: 0.45rem 0.75rem;
    color: var(--color-text);
    border: 1px solid transparent;
  }

  :global(.status-active) {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.4);
  }

  :global(.status-complete) {
    background: rgba(61, 133, 96, 0.10);
    border-color: rgba(61, 133, 96, 0.55);
  }

  :global(.status-prototype),
  :global(.status-archived) {
    background: rgba(100, 130, 110, 0.14);
    border-color: rgba(100, 130, 110, 0.45);
  }

  :global(.link-row) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  :global(.link-row a),
  :global(.inline-link) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  :global(.link-row a) {
    justify-content: center;
    padding: 0.7rem 0.95rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: rgba(61, 133, 96, 0.05);
    font-weight: 600;
  }

  :global(.link-row a:hover),
  :global(.link-row a:focus-visible),
  :global(.inline-link:hover),
  :global(.inline-link:focus-visible) {
    border-color: var(--color-accent);
    color: var(--color-accent);
    box-shadow: 0 0 12px rgba(61, 133, 96, 0.12);
  }

  :global(.inline-link) {
    width: fit-content;
    color: var(--color-accent);
    font-weight: 600;
  }

  :global(.split-grid),
  :global(.contact-grid) {
    display: grid;
    gap: 1rem;
  }

  :global(.certification-list) {
    display: grid;
    gap: 1.25rem;
  }

  :global(.education-entry),
  :global(.certification-entry) {
    display: grid;
    gap: 0.45rem;
  }

  :global(.subsection-title) {
    margin-bottom: 0.25rem;
  }

  :global(.contact-grid) {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  :global(.contact-link) {
    display: grid;
    gap: 0.35rem;
    min-height: 5.5rem;
    min-width: 0;
    padding: 1rem;
    background: rgba(8, 18, 12, 0.65);
    border: 1px solid rgba(61, 133, 96, 0.13);
    border-radius: 10px;
    box-shadow: inset 0 1px 0 rgba(61, 133, 96, 0.07);
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  :global(.contact-link:hover) {
    border-color: rgba(61, 133, 96, 0.35);
    box-shadow: inset 0 1px 0 rgba(61, 133, 96, 0.12), 0 4px 20px rgba(61, 133, 96, 0.08);
  }

  :global(.contact-link span) {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
  }

  :global(.contact-link strong) {
    overflow-wrap: anywhere;
    font-size: 1rem;
    line-height: 1.4;
  }

  :global(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.overlay-content h2) {
      animation: parallax-slow linear both;
      animation-timeline: scroll(nearest);
      animation-range: 0% 100%;
    }

    :global(.overlay-content h3) {
      animation: parallax-slow linear both;
      animation-timeline: scroll(nearest);
      animation-range: 0% 100%;
    }

    @keyframes parallax-slow {
      from { transform: translateY(0); }
      to   { transform: translateY(-12px); }
    }
  }

  :global(.overlay-content) {
    position: relative;
  }

  :global(.overlay-content::before) {
    content: attr(data-section);
    position: sticky;
    top: 50%;
    display: block;
    transform: translateY(-50%);
    pointer-events: none;
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 9rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-accent);
    opacity: 0.035;
    white-space: nowrap;
    overflow: hidden;
    z-index: 0;
    line-height: 1;
    margin-bottom: -1em;
  }

  @media (min-width: 768px) {
    :global(.content-card) {
      padding: 1.5rem;
    }

    :global(.project-card) {
      padding-top: 1.5rem;
      padding-right: 9rem;
    }

    :global(.split-grid) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  @media (max-width: 760px) {
    :global(body) {
      overflow: auto;
    }

    :global(.interface-shell) {
      min-height: 100dvh;
      overflow: hidden;
      padding: 1rem;
    }

    :global(.orbit-stage) {
      grid-template-columns: 1fr;
      height: auto;
      min-height: 100dvh;
      padding: 2rem 0;
    }

    :global(.content-column) {
      height: 0;
      min-height: 0;
      padding: 0;
    }

    :global(.content-column::before) {
      display: none;
    }

    :global(.nav-rail) {
      height: auto;
      padding: 1rem 1rem 0.5rem;
      gap: 0.75rem;
      justify-content: flex-start;
    }

    :global(.center-hub) {
      align-items: center;
      align-self: auto;
      padding-top: 1.5rem;
      padding-right: 0;
      padding-left: 1rem;
      padding-bottom: 2rem;
    }

    :global(.center-hub.panel-open) {
      opacity: 1;
      pointer-events: auto;
    }

    :global(.hub-tagline) {
      justify-content: center;
    }

    :global(h1) {
      font-size: clamp(2rem, 10vw, 3rem);
      letter-spacing: 0.04em;
      overflow-wrap: anywhere;
    }

    :global(.particle-name-canvas) {
      width: min(96vw, 28rem);
      height: 5.5rem;
    }

    :global(.game-zone) {
      min-height: 6rem;
      width: 100%;
    }

    :global(.orbit-node) {
      width: min(100%, 22rem);
      font-size: 0.84rem;
    }

    /* Mobile: content panel becomes a fixed overlay */
    :global(.content-panel) {
      position: fixed;
      inset: 1rem 0.75rem;
      z-index: 20;
      border-radius: 10px;
    }

    :global(.panel-backdrop) {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(*),
    :global(*::before),
    :global(*::after) {
      animation-duration: 0.001ms !important;
      transition-duration: 0.001ms !important;
    }
  }
</style>
